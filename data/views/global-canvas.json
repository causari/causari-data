  "suppressedCausalLinks": [
    {
      "id": "genome--enabled-->bitcoin",
      "reason": "Biological decentralization analogy is not sufficient evidence that the Human Genome Project enabled Bitcoin.",
      "reviewState": "legacy-debt"
    },
    {
      "id": "bitcoin--enabled-->ai",
      "reason": "Conceptual cross-pollination is too weak to represent as an enabling causal edge for the AI era.",
      "reviewState": "legacy-debt"
    },
    {
      "id": "darwin_ev--enabled-->relativity",
      "reason": "Analogy about conceptual flexibility is not a supported mechanism from evolutionary theory to relativity.",
      "reviewState": "legacy-debt"
    },
    {
      "id": "relativity--enabled-->turing_m",
      "reason": "Shared intellectual climate is contextual, not a demonstrated enabling mechanism.",
      "reviewState": "legacy-debt"
    },
    {
      "id": "turing_m--enabled-->dna_disc",
      "reason": "The biological-code metaphor does not establish that Turing's computation model enabled discovery of the double helix.",
      "reviewState": "legacy-debt"
    },
    {
      "id": "dna_disc--enabled-->internet",
      "reason": "Molecular-biology information framing did not directly enable ARPANET; the existing evidence conflates contemporaneous information theory.",
      "reviewState": "legacy-debt"
    },
    {
      "id": "printing--caused-->rena",
      "reason": "The Renaissance predates and overlaps Gutenberg printing; 'caused' is too strong for the historical relationship.",
      "reviewState": "legacy-debt"
    },
    {
      "id": "web--enabled-->genome",
      "reason": "The Web supported later collaboration, but is too strong as an enabling cause of the Human Genome Project event.",
      "reviewState": "legacy-debt"
    },
    {
      "id": "iphone--enabled-->transformer",
      "reason": "Smartphone-era data and GPU economics are indirect background conditions, not a sufficiently supported enabling edge.",
      "reviewState": "legacy-debt"
    },
    {
      "id": "turing_m--enabled-->transformer",
      "reason": "Foundational computability is ancestry/context, not a useful direct causal edge to the 2017 Transformer architecture.",
      "reviewState": "legacy-debt"
    },
    {
      "id": "rena--enabled-->darwin_ev",
      "reason": "Long-run humanist influence is contextual and too diffuse to encode as a direct enabling edge.",
      "reviewState": "legacy-debt"
    }
  ],
  "causalLinkPolicy": {
    "blockedSourceTypes": [
      "demo-seed"
    ],
    "allowLinkIds": [
      "lang--enabled-->write",
      "write--enabled-->alex",
      "mcculloch_pitts--enabled-->perceptron"
