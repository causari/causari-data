      "relationship": "context",
      "reason": "The BLS occupation split is relevant to the GenAI-era software-work transition, but this edge does not assert ChatGPT caused the projections."
    },
    {
      "id": "ai--context-->oecd-skill-shortages-2026",
      "fromEvent": "ai",
      "toEvent": "oecd-skill-shortages-2026",
      "relationship": "context",
      "reason": "The OECD skill-shortage evidence belongs to the current AI-and-work context while remaining an independently measured labour-market signal."
