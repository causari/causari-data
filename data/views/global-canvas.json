    {
      "id": "chatgpt--context-->ilo-genai-empirical-review-2026",
      "fromEvent": "chatgpt",
      "toEvent": "ilo-genai-empirical-review-2026",
      "relationship": "context",
      "reason": "The ILO review synthesizes empirical evidence about GenAI at work after widespread generative-AI adoption. Context only."
    },
    {
      "id": "chatgpt--context-->bls-2025-2035-ai-occupation-split",
      "fromEvent": "chatgpt",
      "toEvent": "bls-2025-2035-ai-occupation-split",
      "relationship": "context",
      "reason": "The BLS occupation split is relevant to the GenAI-era software-work transition, but this edge does not assert ChatGPT caused the projections."
    },
    {
      "id": "ai--context-->oecd-skill-shortages-2026",
      "fromEvent": "ai",
      "toEvent": "oecd-skill-shortages-2026",
      "relationship": "context",
      "reason": "The OECD skill-shortage evidence belongs to the current AI-and-work context while remaining an independently measured labour-market signal."
    },
    {
      "id": "chatgpt--context-->imf-asia-ai-labor-market-2026",
      "fromEvent": "chatgpt",
      "toEvent": "imf-asia-ai-labor-market-2026",
      "relationship": "context",
      "reason": "The IMF study explicitly compares hiring demand across AI-exposed occupations in the post-ChatGPT period. Contextual association is not a causal claim."
    },
    {
      "id": "dartmouth_conf--context-->deep_blue",
      "fromEvent": "dartmouth_conf",
      "toEvent": "deep_blue",
      "relationship": "context",
      "reason": "Deep Blue belongs to the long symbolic/search AI tradition associated with the field Dartmouth helped name, but the four-decade lineage is too indirect for a causal edge."
    },
    {
      "id": "deep_blue--context-->alphago",
      "fromEvent": "deep_blue",
      "toEvent": "alphago",
      "relationship": "context",
      "reason": "Deep Blue and AlphaGo form a meaningful game-AI milestone lineage, but AlphaGo's technical ancestry is not a direct causal continuation of Deep Blue."
    },
    {
      "id": "genome--context-->alphafold2",
      "fromEvent": "genome",
      "toEvent": "alphafold2",
      "relationship": "context",
      "reason": "The genomics era expanded sequence data used by modern protein models, but the Human Genome Project itself is too broad a proxy to encode as a direct enabling cause of AlphaFold 2."
    },
    {
      "id": "alexnet--context-->alphafold2",
      "fromEvent": "alexnet",
      "toEvent": "alphafold2",
      "relationship": "context",
      "reason": "AlexNet marks the deep-learning-at-scale methodological shift that contextualizes AlphaFold 2, but it is not a direct technical prerequisite of AlphaFold 2's architecture."
    },
    {
      "id": "imagenet--context-->transformer",
      "fromEvent": "imagenet",
      "toEvent": "transformer",
      "relationship": "context",
      "reason": "ImageNet/AlexNet established a deep-learning-at-scale research paradigm, but the Transformer architecture arose from sequence-modeling work rather than a direct ImageNet causal mechanism."
    },
    {
      "id": "lang--context-->write",
      "fromEvent": "lang",
      "toEvent": "write",
      "relationship": "context",
      "reason": "Writing is structurally related to language, but its emergence also depends on notation systems, cognition and sociohistorical institutions; represent this as context rather than a single direct cause."
    }
  ],
